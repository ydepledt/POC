# API : https://console.groq.com/keys
GROQ_API_KEY=
# API : https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Session X depuis le navigateur : cookies auth_token et ct0 (prioritaires).
X_AUTH_TOKEN=
X_CT0=

# Autre option : identifiants X, ou cookies dans data/x_cookies.json.
# La connexion par identifiants peut échouer avec la nouvelle page X.
X_USERNAME=
X_EMAIL=
X_PASSWORD=

# Recherches libres V1 facultatives, ajoutées aux thèmes actifs.
# Pour ajouter des thèmes filtrables, passe par l'interface Streamlit.
KEYWORDS=
SEARCH_COUNT=20
POLL_MINUTES=15
BATCH_SIZE=12
# Fenêtre de recherche de doublons événementiels (en heures), 24 à 720
DEDUP_LOOKBACK_HOURS=96
DB_PATH=data/watch.db
